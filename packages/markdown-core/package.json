{
  "name": "@easyview/markdown-core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-neutral Markdown models and transformations for EasyView",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./editor-settings": "./src/models/editor-settings.ts",
    "./frontmatter": "./src/parsing/frontmatter.ts",
    "./table-style-metadata": "./src/serialization/table-style-metadata.ts",
    "./pandoc-highlight-markup": "./src/transforms/pandoc-highlight-markup.ts",
    "./document": "./src/document/index.ts"
  },
  "files": [
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "prosemirror-model": "^1.25.4",
    "prosemirror-tables": "^1.8.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
