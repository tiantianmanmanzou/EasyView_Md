{
  "name": "@easyview/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EasyView desktop application",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build -- --production && npm run prepare:runtime && electron-forge package",
    "make": "npm run build -- --production && npm run prepare:runtime && electron-forge make",
    "make:dmg": "node scripts/make-dmg.mjs",
    "make:mac": "npm run make && npm run make:dmg",
    "test:e2e": "npm run build -- --production && playwright test -c playwright.desktop.config.ts",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:runtime": "node scripts/verify-packaged-runtime.mjs"
  },
  "devDependencies": {
    "@easyview/contracts": "0.1.0",
    "@easyview/editor-core": "*",
    "@easyview/node-runtime": "*",
    "@easyview/preview-ui": "*",
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron/asar": "^3.4.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@file-viewer/doc": "^3.1.1",
    "@file-viewer/ppt": "^0.3.3",
    "@file-viewer/react-full": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dompurify": "^3.3.2",
    "heic2any": "^0.0.4",
    "pako": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "productName": "EasyView_Md"
}
