{
  "name": "easyview-md",
  "displayName": "EasyView_Md",
  "description": "%extension.description%",
  "version": "2.2.60",
  "publisher": "zhangxy",
  "license": "MIT",
  "private": true,
  "icon": "dist/brand/logo.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiantianmanmanzou/EasyView_Md.git"
  },
  "homepage": "https://github.com/tiantianmanmanzou/EasyView_Md#readme",
  "bugs": {
    "url": "https://github.com/tiantianmanmanzou/EasyView_Md/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "visual-editor",
    "markdown-editor",
    "document-converter",
    "export"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "node scripts/package-vsix.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "activationEvents": [
    "*",
    "onFileSystem:easyviewMd",
    "onCustomEditor:easyviewMd.markdownEditor",
    "onCustomEditor:easyviewMd.filePreview",
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onCommand:easyviewMd.openEditor",
    "onCommand:easyviewMd.openNativeEditor",
    "onCommand:easyviewMd.cycleProductTheme",
    "onView:easyviewMd.workspaceFiles",
    "onCommand:easyviewMd.workspace.refresh",
    "onCommand:easyviewMd.workspace.configureSort",
    "onCommand:easyviewMd.workspace.search",
    "onCommand:easyviewMd.workspace.newFile",
    "onCommand:easyviewMd.workspace.newFolder",
    "onCommand:easyviewMd.workspace.revealCurrentFile",
    "onCommand:easyviewMd.workspace.revealInIndexArea",
    "onCommand:easyviewMd.workspace.openPreview",
    "onCommand:easyviewMd.workspace.openExternal",
    "onCommand:easyviewMd.workspace.copyResourceUri",
    "onCommand:easyviewMd.workspace.copyPath",
    "onCommand:easyviewMd.workspace.copyRelativePath",
    "onCommand:easyviewMd.workspace.paste",
    "onCommand:easyviewMd.workspace.rename",
    "onCommand:easyviewMd.workspace.delete",
    "onCommand:easyviewMd.showEditorDiagnostics",
    "onView:easyviewMd.versionGuard"
  ],
