    "menus": {
      "editor/title": [
        {
          "command": "easyviewMd.openEditor",
          "when": "activeCustomEditorId != 'easyviewMd.markdownEditor' && (resourceLangId == markdown || resourceLangId == mdx || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx)",
          "group": "navigation@-100"
        },
        {
          "command": "easyviewMd.openNativeEditor",
          "when": "activeCustomEditorId == 'easyviewMd.markdownEditor'",
          "group": "navigation@-100"
        }
      ],
      "editor/title/context": [
        {
          "command": "easyviewMd.workspace.revealInIndexArea",
          "group": "2_files@2"
        }
      ],
      "explorer/context": [
        {
          "command": "easyviewMd.workspace.revealInIndexArea",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@90"
        },
        {
          "command": "easyviewMd.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation@1"
        },
        {
          "command": "easyviewMd.openNativeEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation@2"
        },
        {
          "command": "easyviewMd.convertWordToMarkdown",
          "when": "resourceExtname == .docx || resourceExtname == .doc",
          "group": "navigation@3"
        },
        {
          "command": "easyviewMd.convertPdfToMarkdown",
          "when": "resourceExtname == .pdf",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "easyviewMd.workspace.search",
          "when": "view == easyviewMd.workspaceFiles",
          "group": "navigation@0"
        },
        {
          "command": "easyviewMd.workspace.configureSort",
          "when": "view == easyviewMd.workspaceFiles",
          "group": "navigation@5"
        },
        {
          "command": "easyviewMd.workspace.newFile",
          "when": "view == easyviewMd.workspaceFiles",
          "group": "navigation@1"
        },
        {
          "command": "easyviewMd.workspace.newFolder",
          "when": "view == easyviewMd.workspaceFiles",
          "group": "navigation@2"
        },
        {
          "command": "easyviewMd.workspace.refresh",
          "when": "view == easyviewMd.workspaceFiles",
          "group": "navigation@3"
        },
        {
          "command": "easyviewMd.versionGuard.refresh",
          "when": "view == easyviewMd.versionGuard",
          "group": "navigation@0"
        },
        {
          "command": "easyviewMd.versionGuard.expandAll",
          "when": "view == easyviewMd.versionGuard && !easyviewMd.versionGuard.allExpanded",
          "group": "navigation@1"
        },
        {
          "command": "easyviewMd.versionGuard.collapseAll",
          "when": "view == easyviewMd.versionGuard && easyviewMd.versionGuard.allExpanded",
          "group": "navigation@1"
        },
        {
          "command": "easyviewMd.workspace.collapseAll",
          "when": "view == easyviewMd.workspaceFiles",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+shift+b",
        "command": "-workbench.action.tasks.build",
        "when": "activeCustomEditorId == 'easyviewMd.markdownEditor'"
      },
      {
        "key": "ctrl+z",
        "command": "easyviewMd.undo",
        "when": "activeCustomEditorId == 'easyviewMd.markdownEditor'"
      },
      {
        "key": "ctrl+shift+z",
        "command": "easyviewMd.redo",
        "when": "activeCustomEditorId == 'easyviewMd.markdownEditor'"
      },
      {
        "key": "ctrl+y",
        "command": "easyviewMd.redo",
        "when": "activeCustomEditorId == 'easyviewMd.markdownEditor'"
      },
      {
        "key": "alt+s",
        "mac": "alt+s",
        "command": "easyviewMd.stageFile",
        "when": "activeCustomEditorId == 'easyviewMd.markdownEditor'"
      },
      {
        "key": "alt+e",
        "mac": "alt+e",
        "command": "easyviewMd.openEditor",
        "when": "editorTextFocus && (resourceLangId == markdown || resourceLangId == mdx)"
      },
      {
        "key": "enter",
        "command": "easyviewMd.workspace.rename",
        "when": "focusedView == easyviewMd.workspaceFiles && easyviewMd.workspaceFiles.entrySelected && !inputFocus && !easyviewMd.workspaceFiles.inputFocus"
      },
      {
        "key": "f2",
        "command": "easyviewMd.workspace.rename",
        "when": "focusedView == easyviewMd.workspaceFiles && easyviewMd.workspaceFiles.entrySelected && !inputFocus && !easyviewMd.workspaceFiles.inputFocus"
      },
      {
        "key": "delete",
        "command": "easyviewMd.workspace.delete",
        "when": "focusedView == easyviewMd.workspaceFiles && easyviewMd.workspaceFiles.entrySelected && !isMac && !easyviewMd.workspaceFiles.inputFocus"
      },
      {
        "key": "cmd+backspace",
        "command": "easyviewMd.workspace.delete",
        "when": "focusedView == easyviewMd.workspaceFiles && easyviewMd.workspaceFiles.entrySelected && isMac && !easyviewMd.workspaceFiles.inputFocus"
      },
      {
        "key": "delete",
        "command": "easyviewMd.workspace.delete",
        "when": "focusedView == easyviewMd.workspaceFiles && easyviewMd.workspaceFiles.entrySelected && isMac && !easyviewMd.workspaceFiles.inputFocus"
      }
    ],
    "configurationDefaults": {
      "markdown.editor.filePaste.enabled": "smart",
      "markdown.editor.filePaste.copyIntoWorkspace": "mediaFiles",
      "[markdown]": {
        "editor.fontFamily": "\"Sarasa Mono SC\", \"Sarasa Fixed SC\", \"SF Mono\", Menlo, Monaco, \"Courier New\", monospace"
      },
      "[mdx]": {
        "editor.fontFamily": "\"Sarasa Mono SC\", \"Sarasa Fixed SC\", \"SF Mono\", Menlo, Monaco, \"Courier New\", monospace"
      }
    },
    "configuration": {
      "title": "EasyView_Md",
      "properties": {
        "easyviewMd.csvDelimiter": {
          "type": "string",
          "enum": [
            ",",
            ";",
            "auto"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.csvDelimiter.enumDescriptions.0%",
            "%config.csvDelimiter.enumDescriptions.1%",
            "%config.csvDelimiter.enumDescriptions.2%"
          ],
          "description": "%config.csvDelimiter.description%"
        },
        "easyviewMd.nativeDecorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.nativeDecorations.enabled.description%"
        },
        "easyviewMd.nativeDecorations.mermaid.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.nativeDecorations.mermaid.enabled.description%"
        },
        "easyviewMd.nativeDecorations.tables.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.nativeDecorations.tables.enabled.description%"
        },
        "easyviewMd.nativeEditor.forceMonospaceFont": {
          "type": "boolean",
          "default": true,
          "description": "%config.nativeEditor.forceMonospaceFont.description%"
        },
        "easyviewMd.workspace.focusFilesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.workspace.focusFilesOnStartup.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "easyviewMd-workspacePanel",
          "title": "IndexArea",
          "icon": "dist/brand/easyview-editor-dark.svg"
        },
        {
          "id": "easyviewMd-versionGuard",
          "title": "%view.versionGuard.name%",
          "icon": "resources/version-guard.svg"
        }
      ]
    },
    "views": {
      "easyviewMd-workspacePanel": [
        {
          "type": "webview",
          "id": "easyviewMd.workspaceFiles",
          "name": "%view.files.name%",
          "contextualTitle": "IndexArea"
        }
      ],
      "easyviewMd-versionGuard": [
        {
          "type": "webview",
          "id": "easyviewMd.versionGuard",
          "name": "%view.versionGuard.name%"
        }
      ]
    }
  },
  "devDependencies": {
    "@easyview/contracts": "*",
    "@easyview/editor-core": "*",
    "@easyview/markdown-core": "*",
    "@easyview/node-runtime": "*",
    "@easyview/preview-ui": "*",
    "@file-viewer/doc": "^3.1.1",
    "@file-viewer/ppt": "^0.3.3",
    "@file-viewer/react-full": "^3.1.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "dompurify": "^3.3.2",
    "esbuild": "^0.24.0",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@easyview/editor-sync": "*",
    "minimatch": "^9.0.9"
  }
}
